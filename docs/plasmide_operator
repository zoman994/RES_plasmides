## D2. Валидация CDS — проверка стоп-кодонов

**При создании или импорте Part с типом CDS — обязательная проверка.**

### Что проверяется

```javascript
function validateCDS(sequence, annotations) {
  const warnings = [];
  
  // 1. Внутренние (преждевременные) стоп-кодоны
  const protein = translate(sequence);
  const internalStops = [];
  for (let i = 0; i < protein.length - 1; i++) {  // -1: последний * это нормальный стоп
    if (protein[i] === '*') {
      internalStops.push({
        aaPosition: i + 1,
        ntPosition: i * 3,
        codon: sequence.slice(i * 3, i * 3 + 3),
      });
    }
  }
  if (internalStops.length > 0) {
    warnings.push({
      level: 'error',   // красный!
      type: 'premature_stop',
      message: `⛔ ${internalStops.length} преждевременных стоп-кодон(ов)`,
      details: internalStops.map(s => 
        `Позиция ${s.aaPosition}: ${s.codon} (нт ${s.ntPosition + 1})`
      ),
      hint: 'Возможные причины: (1) ген содержит интроны — нужна cDNA, ' +
            '(2) ошибка в последовательности, (3) сдвиг рамки считывания',
      actions: [
        { label: 'Разметить как интроны', action: 'detect_introns' },
        { label: 'Игнорировать', action: 'dismiss' },
      ],
    });
  }
  
  // 2. Нет стоп-кодона на конце
  if (protein.at(-1) !== '*') {
    warnings.push({
      level: 'warning',  // жёлтый
      type: 'no_stop',
      message: '⚠️ Нет стоп-кодона на конце CDS',
      actions: [
        { label: '+TAA', action: 'add_stop_TAA' },
        { label: '+TGA', action: 'add_stop_TGA' },
        { label: '+TAG', action: 'add_stop_TAG' },
      ],
    });
  }
  
  // 3. Нет стартового кодона
  if (sequence.slice(0, 3).toUpperCase() !== 'ATG') {
    warnings.push({
      level: 'warning',
      type: 'no_start',
      message: '⚠️ Последовательность не начинается с ATG',
      actions: [
        { label: '+ATG', action: 'add_start_ATG' },
      ],
    });
  }
  
  // 4. Длина не кратна 3
  if (sequence.length % 3 !== 0) {
    warnings.push({
      level: 'error',
      type: 'frameshift',
      message: `⛔ Длина ${sequence.length} нт не кратна 3 (сдвиг рамки)`,
      hint: `Остаток: ${sequence.length % 3} нт. Проверьте границы CDS.`,
    });
  }
  
  return warnings;
}
```

